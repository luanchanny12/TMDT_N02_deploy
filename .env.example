APP_NAME="DK Social Commerce"
APP_ENV=local
APP_KEY=base64:8NwjIlT2r5+4yc+3BZ4FXp+2JDGxIG1doio63bCj3+4=
APP_DEBUG=true
# APP_URL=https://pulsate-confetti-agility.ngrok-free.dev
APP_URL=http://127.0.0.1:8000
# Proxy tin cậy (phân tách bằng dấu phẩy). Dùng ngrok/cloudflared trỏ vào máy: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_commerce
DB_USERNAME=root
DB_PASSWORD=your_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Khi triển khai HTTPS thật thì bật (KHÔNG bật trên local http://):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDRESS="noreply@dksocialcommerce.local"
MAIL_FROM_NAME="DK Social Commerce"

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Facebook Login (Laravel Socialite) — để trống thì ẩn nút đăng nhập Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"

# Gemini API (Chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Microservice chatbot AI (services/ai-service). Để trống AI_SERVICE_URL thì Laravel gọi Gemini trực tiếp.
# Chạy không dùng Docker: cd services/ai-service && AI_SERVICE_TOKEN=... GEMINI_API_KEY=... npm start
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Referral System
REFERRAL_COMMISSION_PERCENT=5

# Backup DB (tùy chọn — trỏ tới mysqldump nếu không có trong PATH)
# MYSQLDUMP_PATH=D:\xampp\mysql\bin\mysqldump.exe

# ---------------------------------------------------------------------------
# DOCKER (Cách A — xem 03_Deployment/INSTALL.md)
# Khi chạy `docker compose up`, biến trong docker-compose.yml override các giá trị
# dưới đây (DB_HOST=mysql, MAIL_HOST=mailpit, APP_URL=http://localhost:8081…).
# Hoặc copy .env.docker.example → .env rồi key:generate.
# ---------------------------------------------------------------------------
