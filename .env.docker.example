APP_NAME="DK Social Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DOCKER_APP_DEBUG=false
APP_URL=http://localhost:8081
# Proxy tin cậy (phân tách bằng dấu phẩy). Dùng ngrok/cloudflared trỏ vào máy: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=social_commerce
DB_USERNAME=social
DB_PASSWORD=social_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@dksocialcommerce.local"
MAIL_FROM_NAME="DK Social Commerce"

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback

# Facebook Login (Laravel Socialite) — để trống thì ẩn nút đăng nhập Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8081/auth/facebook/callback

# VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8081/payment/vnpay/return

# Gemini API (Chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Microservice chatbot AI — docker-compose tự đặt AI_SERVICE_URL=http://ai-service:3000.
# Đổi token này trước khi public website.
AI_SERVICE_TOKEN=local-dev-ai-token

# Referral System
REFERRAL_COMMISSION_PERCENT=5

# Backup DB — khi chạy Docker: mysqldump có sẵn trong container app
# (không cần MYSQLDUMP_PATH; hoặc chỉ định /usr/bin/mysqldump)
